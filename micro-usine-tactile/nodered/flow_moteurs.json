  {
    "id": "f_tpl",
    "type": "ui_template",
    "z": "f_tab",
    "group": "g_aff",
    "name": "Affichage directions",
    "order": 1,
    "width": "6",
    "height": "3",
    "format": "<style>\n.axe-ligne{display:flex;align-items:center;justify-content:space-between;margin:6px 0;padding:6px 12px;border-radius:10px;background:rgba(128,128,128,0.15)}\n.axe-nom{font-weight:bold;font-size:18px}\n.fl{font-size:18px;color:#999;min-width:110px;text-align:center;border-radius:8px;padding:4px}\n.fl.on{background:#27AE60;color:#fff}\n</style>\n<div class=\"axe-ligne\" ng-repeat=\"a in axes\">\n  <span class=\"fl\" ng-class=\"{on: a.dir===-1}\">{{a.neg}}</span>\n  <span class=\"axe-nom\">{{a.nom}}</span>\n  <span class=\"fl\" ng-class=\"{on: a.dir===1}\">{{a.pos}}</span>\n</div>\n<script>\n(function(scope){\n  scope.axes = [\n    {nom:'X', neg:'▼ Arrière', pos:'▲ Avant',  dir:0},\n    {nom:'Y', neg:'◀ Gauche',  pos:'▶ Droite', dir:0},\n    {nom:'Z', neg:'▼ Bas',     pos:'▲ Haut',   dir:0}\n  ];\n  scope.$watch('msg', function(msg){\n    if (!msg || !msg.payload) return;\n    var p = msg.payload;\n    scope.axes.forEach(function(a){ a.dir = 0; });\n    if (p.etat === 'MOUVEMENT') {\n      var idx  = {X:0, Y:1, Z:2}[p.axe];\n      var sens = {AVANT:1, ARRIERE:-1, DROITE:1, GAUCHE:-1, HAUT:1, BAS:-1}[p.sens];\n      if (idx !== undefined && sens !== undefined) { scope.axes[idx].dir = sens; }\n    }\n  });\n})(scope);\n</script>",
    "storeOutMessages": true,
    "fwdInMessages": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 410,
    "y": 470,
    "wires": [
      []
    ]
  }
