  {
    "id": "f_func",
    "type": "function",
    "z": "f_tab",
    "name": "Mise en forme du statut",
    "func": "var d = msg.payload;\nif (typeof d !== 'object' || d === null) return null;\n\nvar dernier = null;\nif (d.axe && d.sens) {\n    var fleches = {AVANT:'▲', ARRIERE:'▼', GAUCHE:'◀', DROITE:'▶', HAUT:'▲', BAS:'▼'};\n    var f = fleches[d.sens] || '';\n    dernier = { payload: f + ' Axe ' + d.axe + ' : ' + d.sens + ' (' + d.duree + ' ms)' };\n}\n\nvar etat = { payload: (d.etat === 'MOUVEMENT') ? 'EN MOUVEMENT' : 'ARRÊTÉ' };\nreturn [dernier, etat];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 520,
    "wires": [
      [
        "t_dernier"
      ],
      [
        "t_etat"
      ]
    ]
  },
  {
    "id": "t_dernier",
